<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_account_gt_move_form" model="ir.ui.view">
            <field name="name">account_gt.account.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                  <group id="header_right_group" position="inside">
                      <field name="fel_serie" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                      <field name="fel_numero" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                  </group>                
                <field name="fiscal_position_id" position="after">
                    <field name="liquidacion_id"/>
                    <field name="tipo_factura"/>
                </field>
                <page name="other_info" position="after">
                    <page name="datos_fexp" string="Datos Factura exportación">
                        <group>
                            <field name="lugar_expedicion"/>
                            <field name="consignatario_destinatario_id"/>
                            <field name="comprador_id"/>
                            <field name="exportador_id"/>
                        </group>   
                        <group>
                            <field name="otra_referencia"/>
                            <field name="incoterm_exp"/>
                        </group>  
                    </page>    
                </page>
            </field>
        </record>
        
    <record id="infilefel_view_company_form" model="ir.ui.view">
      <field name="name">infilefel.res.company.form</field>
      <field name="model">res.company</field>
      <field name="inherit_id" ref="base.view_company_form"/>
      <field name="arch" type="xml">
        <field name="vat" position="after">
            <field name="anulado_libro_compras"/>
        </field>    
      </field>
    </record>  
        
    </data>
</odoo>
